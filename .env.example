# Gmail / Google API
GOOGLE_OAUTH_CLIENT_SECRET_FILE=/path/to/client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=/path/to/gmail_token.json
GMAIL_QUERY=label:"Investor/Quarterly"

# Postgres
LPUPDATE_DATABASE_URL=postgresql://user:password@localhost:5432/lpupdate

# Parser selection
LPUPDATE_PARSE_PROVIDER=rules

# bem.ai parser integration
BEM_API_URL=https://api.bem.ai/v2/calls
BEM_API_KEY=your_bem_api_key
LPUPDATE_BEM_TIMEOUT_SECONDS=60
BEM_WORKFLOW_NAME=your_workflow_slug
BEM_FUNCTION_NAME=Parse-email-update
